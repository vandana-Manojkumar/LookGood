# LiteLLM Configuration (UKG Internal Proxy)
# Use your UKG LiteLLM virtual key
LITELLM_API_KEY=your-litellm-api-key-here

# LiteLLM Proxy Base URL (defaults to UKG internal proxy)
LITELLM_BASE_URL=https://sdlc-llm.ukg.int

# Model Selection (default: claude-sonnet-4)
# Available models: claude-sonnet-4, claude-sonnet-4-5, etc.
AI_MODEL=claude-sonnet-4

# Alternative: Direct OpenAI API Key (if not using LiteLLM)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Server Port (Optional - defaults to 5000)
PORT=5000

# Database Configuration (Optional - currently uses in-memory storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
